{
  "about": "Written key-sequence checks and focus-walk screens, run by scripts/qa on every target. Keys: up, down, start, end, select, back. start/end are left/right in English and right/left in Arabic. Expectations are focus ids (testID); * matches anything; $name is an id captured earlier in the same check. A check with \"languages\" runs only in those.",
  "links": {
    "album": "album/dNdfcri79XQ",
    "photo": "photo/SgtU7sK6oP4"
  },
  "checks": [
    {
      "name": "Home opens on the first album; header and rails are reachable",
      "start": "home",
      "steps": [
        {
          "expect": "album-card-*",
          "capture": "firstAlbum"
        },
        {
          "key": "end",
          "expect": "album-card-*",
          "notExpect": "$firstAlbum"
        },
        {
          "key": "start",
          "expect": "$firstAlbum"
        },
        {
          "key": "start",
          "expect": "$firstAlbum",
          "why": "the rail's first card is its edge"
        },
        {
          "key": "up",
          "expect": "home-search-bar"
        },
        {
          "key": "end",
          "expect": "home-settings"
        },
        {
          "key": "end",
          "expect": "home-settings",
          "why": "nothing beyond Settings"
        },
        {
          "key": "start",
          "expect": "home-search-bar"
        },
        {
          "key": "down",
          "expect": "$firstAlbum",
          "why": "the rail is entered on the card last focused"
        },
        {
          "key": "down",
          "expect": "album-card-*",
          "notExpect": "$firstAlbum",
          "capture": "secondRail",
          "why": "the next rail, on its first card"
        },
        {
          "key": "end",
          "expect": "album-card-*",
          "notExpect": "$secondRail",
          "capture": "secondRailNext"
        },
        {
          "key": "up",
          "expect": "$firstAlbum",
          "why": "each rail is entered on its card last focused"
        },
        {
          "key": "down",
          "expect": "$secondRailNext"
        }
      ]
    },
    {
      "name": "Back on Home asks before leaving; Cancel and Back both stay",
      "start": "home",
      "steps": [
        {
          "expect": "album-card-*",
          "capture": "card"
        },
        {
          "key": "back",
          "expect": "exit-cancel",
          "wait": 800
        },
        {
          "key": "end",
          "expect": "exit-confirm"
        },
        {
          "key": "end",
          "expect": "exit-confirm",
          "why": "focus stays inside the dialog"
        },
        {
          "key": "up",
          "expect": "exit-confirm"
        },
        {
          "key": "start",
          "expect": "exit-cancel"
        },
        {
          "key": "select",
          "expect": "$card",
          "wait": 800,
          "why": "Cancel returns focus to where it was"
        },
        {
          "key": "back",
          "expect": "exit-cancel",
          "wait": 800
        },
        {
          "key": "back",
          "expect": "$card",
          "wait": 800
        }
      ]
    },
    {
      "name": "An album link opens the album; grid and header remember focus; Back works",
      "start": "link:album",
      "steps": [
        {
          "expect": "photo-card-*",
          "capture": "first",
          "wait": 3000
        },
        {
          "key": "end",
          "expect": "photo-card-*",
          "notExpect": "$first",
          "capture": "second"
        },
        {
          "key": "down",
          "expect": "photo-card-*",
          "notExpect": "$second"
        },
        {
          "key": "up",
          "expect": "$second"
        },
        {
          "key": "start",
          "expect": "$first"
        },
        {
          "key": "up",
          "expect": "album-back"
        },
        {
          "key": "end",
          "expect": "album-search"
        },
        {
          "key": "end",
          "expect": "album-slideshow"
        },
        {
          "key": "down",
          "expect": "$first",
          "why": "the grid is entered on the photo last focused, not the nearest"
        },
        {
          "key": "up",
          "expect": "album-slideshow",
          "why": "the header is entered on the button last focused"
        },
        {
          "key": "down",
          "expect": "$first"
        },
        {
          "key": "back",
          "expect": "album-card-*",
          "wait": 1500,
          "why": "a link opened at launch goes back to Home"
        }
      ]
    },
    {
      "name": "Viewer: the filmstrip follows focus and Back lands on the photo last viewed",
      "start": "link:album",
      "steps": [
        {
          "expect": "photo-card-*",
          "wait": 3000
        },
        {
          "key": "select",
