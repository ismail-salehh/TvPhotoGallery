          "key": "up",
          "expect": "photo-*",
          "why": "a header button"
        },
        {
          "key": "down",
          "expect": "$next",
          "why": "back on the current photo, not the box under the button"
        },
        {
          "key": "back",
          "expect": "photo-card-*",
          "wait": 1500
        }
      ]
    },
    {
      "name": "Slideshow: controls in order; Back pauses, then leaves",
